# Use your machine LAN IP for Expo Go on a physical device (not 127.0.0.1).
EXPO_PUBLIC_API_BASE_URL=http://10.0.0.100:5080
# Dev builds fall back to seed/mockData when the API is unreachable; false disables that.
# Production builds never use mocks.
# EXPO_PUBLIC_USE_MOCKS=false
# Crash reporting (release builds; set via EAS env for cloud builds — see DEV.md).
# EXPO_PUBLIC_SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
# EXPO_PUBLIC_SENTRY_IN_DEV=true   # also report from dev builds
# SENTRY_AUTH_TOKEN goes in mobile/.env.local (gitignored), never here.
