# Ingest (realtime_ingestion)
REDIS_URL=redis://127.0.0.1:6379/0
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
KOKORO_VOICE=af_heart
TTS_ENABLED=true
GPU_GATE_ENABLED=true
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=cnews
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=ca-central-1
S3_BUCKET=cnews-audio
S3_ACCESS_KEY=cnewsminio
S3_SECRET_KEY=cnewsminio
S3_FORCE_PATH_STYLE=true
S3_PREFIX=audio/opus
PUBLISH_ENABLED=true
PUBLISH_REQUIRE_AUDIO=false

# Backend
ASPNETCORE_ENVIRONMENT=Development
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=cnews
POSTGRES_CONNECTION=Host=127.0.0.1;Port=5432;Database=cnews;Username=cnews;Password=cnews
S3_BUCKET=cnews-audio
S3_REGION=ca-central-1
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=cnewsminio
S3_SECRET_KEY=cnewsminio
S3_FORCE_PATH_STYLE=true
AUDIO_URL_TTL_SECONDS=900
JWT_SIGNING_KEY=dev-only-change-me-to-a-long-random-secret
GOOGLE_CLIENT_IDS=

# Mobile
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:5080
