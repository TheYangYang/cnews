# Ingest (realtime_ingestion)
REDIS_URL=redis://127.0.0.1:6379/0
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
KOKORO_VOICE=af_heart
TTS_ENABLED=true
GPU_GATE_ENABLED=true
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=cnews
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=ca-central-1
S3_BUCKET=cnews-audio
S3_ACCESS_KEY=cnewsminio
S3_SECRET_KEY=cnewsminio
S3_FORCE_PATH_STYLE=true
S3_PREFIX=audio/opus
PUBLISH_ENABLED=true
PUBLISH_REQUIRE_AUDIO=false
# GPU scheduling (defaults suit one 6 GB card such as a GTX 1060; see pipeline.md)
# TTS_DEVICE=auto              # auto | cuda | cpu
# GPU_SWAP_MODELS=true         # unload Ollama during speech turns; park Kokoro on CPU after
# OLLAMA_NUM_CTX=3072          # same on every call, or Ollama reloads the model
# OLLAMA_KEEP_ALIVE=30m
# TTS_IDLE_GRACE_SECONDS=4     # LLM quiet time before a speech turn
# TTS_MAX_LAG_SECONDS=240      # force a speech turn when a brief waited this long
# TTS_TURN_MIN=4               # briefs spoken per turn before yielding to new articles
# TTS_TURN_MAX=12              # ...per forced turn
# ENRICH_MAX_LAG_SECONDS=900   # storylines/framing run at least this often under load
# ARTICLE_BACKLOG_MAX=40       # pause RSS intake while this many articles wait for a brief
# FEED_POLL_CONCURRENCY=6
# RETENTION_DAYS=7            # local rows (no text/audio) kept for dedupe; minimum 7
# STORY_RETENTION_DAYS=14      # MongoDB + S3: stories removed 14 days after publishing...
# CLOSED_STORYLINE_RETENTION_DAYS=30   # ...unless a storyline holds them (removed 30d after closing)
# STORYLINE_STALE_DAYS=7       # auto-close storylines with no update for 7 days
# PRUNE_PUBLISHED=true         # false = never delete from MongoDB/S3 (e.g. against demo seed data)
# UPLOAD_RETRY_INTERVAL_SECONDS=600   # retry audio that failed to reach S3
# UI_HOST=127.0.0.1            # set 0.0.0.0 to reach the ops page from the LAN

# Backend
ASPNETCORE_ENVIRONMENT=Development
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=cnews
POSTGRES_CONNECTION=Host=127.0.0.1;Port=5432;Database=cnews;Username=cnews;Password=cnews
S3_BUCKET=cnews-audio
S3_REGION=ca-central-1
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=cnewsminio
S3_SECRET_KEY=cnewsminio
S3_FORCE_PATH_STYLE=true
AUDIO_URL_TTL_SECONDS=900
JWT_SIGNING_KEY=dev-only-change-me-to-a-long-random-secret
GOOGLE_CLIENT_IDS=

# Mobile
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:5080
